# ==========================================
# Recall — .gitignore
# Exclude sensitive, personal, runtime and generated files
# ==========================================

# --- Environment & Credentials ---
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.crt
.npmrc
.pypirc
.netrc
pip.conf
credentials.json
service-account.json
secrets.yaml
secrets.yml
id_rsa
id_ed25519
*.p12
*.pfx
*.jks
*.keystore
*.tsbuildinfo

# --- Application Data & SQLite Databases ---
data/
storage/
backups/
media/
tts_cache/
quizlet_chrome_profile/
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite-journal
*.sqlite3-journal
*.bak
*.sql
*.dump

# --- Python & Virtual Environments ---
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.installed.cfg

# --- Node.js & Frontend ---
node_modules/
frontend/node_modules/
frontend/dist/
.npm/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Testing & Quality Tools ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
playwright-report/
test-results/
.mypy_cache/
.ruff_cache/

# --- Logs & Runtime Temp Files ---
*.log
logs/
tmp/
temp/
*.tmp
*.temp

# --- Operating System & Editor Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
