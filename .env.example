# --- Основное ---
APP_ENV=dev                      # dev | production
APP_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=                    # через запятую; в dev обычно пусто (тот же origin через Vite proxy)
DATA_DIR=./data                  # база: DATA_DIR/app.sqlite3, медиа: DATA_DIR/media

# --- Сессии ---
SESSION_COOKIE_NAME=recall_session
SESSION_TTL_SECONDS=1209600      # 14 дней
PRE_AUTH_TTL_SECONDS=900

# --- Защита ---
RATE_LIMIT_LOGIN_ATTEMPTS=10     # попыток
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_REDEEM_PER_WINDOW=30

# --- Лимиты (значения показываются пользователю до загрузки) ---
MAX_IMAGE_BYTES=8388608          # 8 MiB, не более 20 мегапикселей
MAX_AUDIO_BYTES=26214400         # 25 MiB
MAX_IMPORT_BYTES=10485760        # 10 MiB CSV/TSV/JSON/текст
MAX_ZIP_COMPRESSED_BYTES=104857600
MAX_ZIP_UNCOMPRESSED_BYTES=262144000
MAX_CARDS_PER_SET=5000
MAX_IMPORT_ROWS=5000
PAGE_DEFAULT_SIZE=50
PAGE_MAX_SIZE=200
MAX_TEST_QUESTIONS=100

# --- Локализация ---
DEFAULT_LOCALE=ru
ALLOWED_LOCALES=ru,en
DEFAULT_TIMEZONE=Europe/Moscow

# --- SQLite ---
SQLITE_SYNCHRONOUS=FULL          # FULL | NORMAL (осознанная настройка администратора)
SQLITE_BUSY_TIMEOUT_MS=5000
